#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * LAYER ORDER MATTERS.
 * ZMK resolves a keypress by looking at every active layer and using the
 * HIGHEST-numbered one that isn't &trans. So the order below is deliberate:
 *
 *   BASE (0) < LINUX (1) < SYM (2) < GAME (3) < NAV (4) < GAME2 (5)
 *
 * - GAME2 must sit above GAME, otherwise holding the GAME2 key while gaming would
 *   activate GAME2 underneath the gaming layer and you'd never see it.
 * - LINUX is a tiny "overlay" that is normally OFF. It changes one key (see below).
 *   It must sit BELOW SYM so that holding SYM stops the BASE<->GAME combos from firing.
 * - A layer's number comes from its position in the keymap below, so the layer
 *   blocks must stay in this same order.
 *
 * Mapping to your names:
 *   BASE = Coding layer 1   SYM = Coding layer 2   NAV = Coding layer 3
 *   GAME = Gaming layer     GAME2 = Gaming function layer (held from GAME only)
 *
 * Layer 0 is the "default layer" and is always active at the bottom of the stack.
 */
#define BASE  0
#define LINUX 1
#define SYM   2
#define GAME  3
#define NAV   4
#define GAME2 5

/*
 * Key positions. Numbering is left-to-right, top-to-bottom:
 *    0-11  number row (Lotus only - not on the Corne, left alone on SYM/NAV)
 *   12-23  Q row      (Corne top row)
 *   24-37  A row      (Corne home row). 30 is NOT a key on your board (it's the screen);
 *                     31 is the right encoder click.
 *   38-51  Z row      (Corne bottom row; 44, 45 = the two inner keys, used for the game combo)
 *   52-55  left thumbs   (52 spare | 53 = Corne outer, 54 = Corne middle, 55 = Corne inner)
 *   56-59  right thumbs  (56 = Corne inner, 57 = Corne middle, 58 = Corne outer | 59 spare)
 */

/ {
    macros {
        // Vim macro replays from the work layout (M3 / M4): types "@q" / "@w".
        macro_at_q: macro_at_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp AT &kp Q>;
        };

        macro_at_w: macro_at_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp AT &kp W>;
        };
    };

    behaviors {
        // Right encoder as a mouse scroll wheel: turn right = scroll down, turn left = scroll up.
        // On this board's right encoder the FIRST binding fires on a turn to the LEFT and the
        // second on a turn to the right (same as the original template's volume knob:
        // "C_VOL_DN C_VOL_UP"), so the order below looks backwards but isn't.
        // ZMK presses then releases the bound behavior for each encoder click. A scroll press
        // only produces output once it has been held for a short while, so tap-ms is raised
        // from its small default. If scrolling is too slow/fast or does nothing, tune tap-ms
        // (or the speed in the SCRL_ bindings). If it scrolls backwards, swap the two bindings.
        scroll_enc: scroll_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <40>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // BASE -> GAME: press both inner bottom-row keys (44 + 45) together.
        // &tog GAME turns the gaming layer on and it STAYS on. (We use &tog rather than &to
        // so that a Linux-mode setting underneath survives a trip into the game layer.)
        // 'layers' = the highest active layer the combo may fire on: only plain BASE
        // (or BASE + the LINUX overlay) - not while holding SYM/NAV, not while gaming.
        combo_to_game {
            timeout-ms = <50>;
            key-positions = <44 45>;
            layers = <BASE LINUX>;
            bindings = <&tog GAME>;
        };

        // GAME -> BASE: same two keys, only active while on the gaming layer.
        // &tog GAME again turns it off, dropping you back onto BASE (or BASE + LINUX).
        combo_to_base {
            timeout-ms = <50>;
            key-positions = <44 45>;
            layers = <GAME>;
            bindings = <&tog GAME>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ---------------------------------------------------------------------------------
        // Coding layer 1 (default) - matches the work Corne base layer.
        //   pos 24 (home-row pinky): hold = NAV (coding 3)
        //   pos 54 (left middle thumb): hold = SYM (coding 2)
        //   pos 53 (left outer thumb): LCTRL here (Windows). See the LINUX layer for Super.
        //   pos 52 (left outermost thumb): LALT
        // Number row (0-11) is Lotus-only, so it's just numbers.
        // pos 44 / 45 are unbound - they're the BASE<->GAME combo keys (and [ ] live on SYM).
        // pos 31 = encoder click (mute); pos 30 isn't a key.
        // ---------------------------------------------------------------------------------
        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3  &kp N4   &kp N5                              &kp N6    &kp N7  &kp N8    &kp N9   &kp N0   &kp EQUAL
&kp TAB   &kp Q  &kp W  &kp E   &kp R    &kp T                               &kp Y     &kp U   &kp I     &kp O    &kp P    &kp ESC
&mo NAV   &kp A  &kp S  &kp D   &kp F    &kp G   &none       &kp C_MUTE      &kp H     &kp J   &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C   &kp V    &kp B   &none       &none           &kp N     &kp M   &kp COMMA &kp DOT  &kp FSLH &kp RALT
                        &kp LALT &kp LCTRL &mo SYM &kp SPACE  &kp BSPC &kp RET &kp RCTRL &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &scroll_enc>;
        };

        // ---------------------------------------------------------------------------------
        // LINUX overlay. Normally OFF. Toggle it with the &tog LINUX key on the NAV layer.
        // While on, it changes ONE key: pos 53 becomes LGUI (Super, for Omarchy/Hyprland)
        // instead of LCTRL. Everything else is &trans, so it falls through to whatever is
        // below (BASE). ZMK can't detect which OS it's plugged into, so this is a manual switch.
        // The nice_view shows this layer's name ("LINUX") while it's the top layer, as an indicator.
        // (The gem screen upper-cases names and cuts them off after 9 characters.)
        // ---------------------------------------------------------------------------------
        linux_layer {
            display-name = "Linux";
            bindings = <
&trans    &trans   &trans   &trans   &trans   &trans                        &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans   &trans   &trans   &trans   &trans                        &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans   &trans   &trans   &trans   &trans   &trans   &trans      &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans   &trans   &trans   &trans   &trans   &trans   &trans      &trans    &trans    &trans    &trans    &trans    &trans
                            &trans   &kp LGUI &trans   &trans    &trans   &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &scroll_enc>;
        };

        // ---------------------------------------------------------------------------------
        // Coding layer 2: numbers + symbols (Corne layer 1). Hold pos 54 on BASE.
        // The Corne has no number row, so its top row holds 1-5 / 6-0 here; the Lotus's own
        // number row is left as &trans. Legends on the sheet show the shifted symbol above
        // the key, so each key sends the unshifted one (1, [, \ ...).
        //
        // GUESSES - these keys were inked over on the sheet, please check:
        //   pos 46 = _   47 = -   49 = (left as &trans -> '.')   50 = &   51 = ^
        // ---------------------------------------------------------------------------------
        sym_layer {
            display-name = "SYM";
            bindings = <
&trans    &trans   &trans   &trans   &trans   &trans                        &trans    &trans    &trans    &trans    &trans    &trans
&trans    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp EQUAL
&kp GRAVE &kp TILDE &kp LT  &kp LBKT &kp LPAR &kp LBRC &trans   &trans      &kp RBRC  &kp RPAR  &kp RBKT  &kp GT    &kp PLUS  &kp BSLH
&trans    &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT &trans  &trans      &kp UNDER &kp MINUS &kp STAR  &trans    &kp AMPS  &kp CARET
                            &trans   &trans   &trans   &trans    &trans   &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };

        // ---------------------------------------------------------------------------------
        // Gaming layer. Reached by the 44+45 combo from BASE; the same combo returns.
        // Every key is spelled out (no &trans) so nothing leaks through from BASE.
        //
        // ESDF SHIFT: the left half's letters are shifted one column toward the middle, so
        // your fingers rest on the E S D F keys but the keyboard sends W A S D. Games need no
        // rebinding. The outer column is freed up as extra pinky room.
        //   Q row:  N    Tab   Q   [W]   E    R
        //   home:   M    Caps [A]  [S]  [D]   F
        //   bottom: -    Shift Z    X    C    V    B (pos 44)
        // T and G don't fit on the left half any more; they're on GAME2.
        // The number row is NOT shifted: 1-5 stay on the keys labelled 1-5.
        // pos 0 (top-left) is a grave/backtick instead of Esc, so Esc can't be hit by
        // accident; Esc is on GAME2. pos 38 (bottom-left) is unassigned for now.
        // Thumbs: Alt, Ctrl, hold = GAME2, Space (innermost).
        // pos 44 / 45 (the combo keys) send B and ] when tapped alone. Pressing both together
        // still toggles back to BASE.
        // The right half is a normal layout and isn't used much while gaming.
        // ---------------------------------------------------------------------------------
        game_layer {
            display-name = "GAME";
            bindings = <
&kp GRAVE &kp N1   &kp N2 &kp N3 &kp N4  &kp N5                              &kp N6    &kp N7  &kp N8    &kp N9   &kp N0   &kp EQUAL
&kp N     &kp TAB  &kp Q  &kp W  &kp E   &kp R                               &kp Y     &kp U   &kp I     &kp O    &kp P    &kp BSPC
&kp M     &kp CAPS &kp A  &kp S  &kp D   &kp F   &none       &kp C_MUTE      &kp H     &kp J   &kp K     &kp L    &kp SEMI &kp SQT
&none     &kp LSHFT &kp Z &kp X  &kp C   &kp V   &kp B       &kp RBKT        &kp N     &kp M   &kp COMMA &kp DOT  &kp FSLH &kp BSLH
                        &kp LALT &kp LCTRL &mo GAME2 &kp SPACE &kp BSPC &kp RET &kp RCTRL &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // ---------------------------------------------------------------------------------
        // Coding layer 3: function keys, arrows, media, macros (Corne layer 2).
        // Hold pos 24 from BASE. It sits on top of the stack while held, so releasing drops
        // you back to BASE. &trans keys fall through to BASE.
        // (Gaming has its own function layer, GAME2, so this layer is for coding only.)
        //
        // Number row (0-11): Lotus-only, so I used it for Bluetooth select/clear, bootloader,
        // and the Windows/Linux switch (pos 6 = &tog LINUX).
        // Bootloader keys: pos 0 (far-left key, top row) puts the LEFT half into bootloader
        // mode and pos 10 puts the RIGHT half into it - each reboots the half it's pressed on.
        // Hold NAV, then press. To reach them while gaming, leave GAME mode first.
        // Windows virtual desktops (D1-D4 on the sheet):
        //   pos 27 = previous desktop  (Win+Ctrl+Left)
        //   pos 28 = next desktop      (Win+Ctrl+Right)
        //   pos 29 = new desktop       (Win+Ctrl+D)
        //   pos 26 = (D1, unassigned)
        // Other keys, from the notes on the sheet:
        //   M0 screenshot = Win+Shift+S (Snipping Tool), M1 screen recorder = Win+Alt+R (Xbox Game Bar)
        //   M2 = Ctrl+Shift+F10 (PyCharm: run current file)
        //   M3 / M4 = macros typing "@q" / "@w"
        //   pos 57 = Ctrl+B (tmux prefix)
        // F7 / F8 = VS Code prev / next terminal (just the function keys, as on the sheet).
        // pos 44 = Studio unlock (needed to edit this keymap live with ZMK Studio).
        // ---------------------------------------------------------------------------------
        nav_layer {
            display-name = "NAV";
            bindings = <
&bootloader &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4              &tog LINUX &trans    &trans    &trans    &bootloader &bt BT_CLR
&kp TAB   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                        &kp F6     &kp F7    &kp F8    &kp F9    &kp F10   &trans
&trans    &trans   &trans   &kp LG(LC(LEFT)) &kp LG(LC(RIGHT)) &kp LG(LC(D)) &trans &trans  &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
&trans    &macro_at_q &macro_at_w &kp LG(LA(R)) &kp LG(LS(S)) &kp LC(LS(F10)) &studio_unlock &trans  &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP &kp RALT
                            &trans   &trans   &trans   &trans    &trans   &kp LC(B) &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        // ---------------------------------------------------------------------------------
        // GAME2: gaming function layer. Hold the left thumb key pos 54 while on GAME.
        // Movement keys (W A S D, on the physical E S D F keys) are &trans so you can keep
        // moving while holding it. Everything &trans (shown as "." below) falls through to
        // GAME, e.g. Caps, Shift, Z, X.
        //   num row: .    6    7    8    9    0     (on the keys labelled 1-5)
        //   Q row:   .    Esc  F1  [W]   F2   T
        //   home:    PgUp .   [A]  [S]  [D]   G
        //   bottom:  PgDn .    .    .    Play .     (Play = play/pause media)
        // ---------------------------------------------------------------------------------
        game2_layer {
            display-name = "GAME2";
            bindings = <
&trans    &kp N6   &kp N7   &kp N8   &kp N9   &kp N0                        &trans    &trans    &trans    &trans    &trans    &trans
&trans    &kp ESC  &kp F1   &trans   &kp F2   &kp T                         &trans    &trans    &trans    &trans    &trans    &trans
&kp PG_UP &trans   &trans   &trans   &trans   &kp G    &trans   &trans      &trans    &trans    &trans    &trans    &trans    &trans
&kp PG_DN &trans   &trans   &trans   &kp C_PP &trans   &trans   &trans      &trans    &trans    &trans    &trans    &trans    &trans
                            &trans   &trans   &trans   &trans    &trans   &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
